{
  "name": "whatwhy",
  "version": "0.2.0",
  "description": "PRDs say what, ADRs say why: a process for agentic repositories, enforced by one dependency-free script.",
  "keywords": [
    "adr",
    "prd",
    "architecture-decision-records",
    "product-requirements",
    "ai-agents",
    "agents-md",
    "cli",
    "git-hooks"
  ],
  "homepage": "https://github.com/conorluddy/whatwhy#readme",
  "bugs": "https://github.com/conorluddy/whatwhy/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conorluddy/whatwhy.git"
  },
  "license": "MIT",
  "author": "Conor Luddy",
  "type": "module",
  "bin": {
    "whatwhy": "scripts/whatwhy.mjs"
  },
  "files": [
    "scripts/whatwhy.mjs",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/whatwhy.mjs init",
    "test": "node --test scripts/whatwhy.test.mjs",
    "prepublishOnly": "npm test && node scripts/whatwhy.mjs check"
  }
}
